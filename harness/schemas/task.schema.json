{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/vfoti/agent-army/harness/schemas/task.schema.json",
  "title": "Task",
  "description": "Instruction intake contract: a unit of work submitted to the agent army from an external source.",
  "type": "object",
  "required": ["task_id", "source", "goal", "roles"],
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Unique identifier for the task."
    },
    "source": {
      "type": "object",
      "description": "The external system that submitted this task.",
      "required": ["system"],
      "properties": {
        "system": {
          "type": "string",
          "description": "Requesting system, e.g. 'github-issue', 'rest', 'queue', 'folder'."
        },
        "reference": {
          "type": "string",
          "description": "Identifier within the source system, e.g. an issue URL or message id."
        }
      }
    },
    "target": {
      "type": "object",
      "description": "Repository/refs the task operates on.",
      "properties": {
        "repo": { "type": "string" },
        "ref": { "type": "string" }
      }
    },
    "roles": {
      "type": "array",
      "description": "Ordered roles requested for this task.",
      "items": { "enum": ["analysis", "design", "code", "test"] },
      "minItems": 1
    },
    "goal": {
      "type": "string",
      "description": "Goal statement for the task."
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "callback": {
      "type": "object",
      "description": "Where result envelopes should be delivered.",
      "properties": {
        "type": { "enum": ["github-issue", "webhook", "queue", "folder"] },
        "destination": { "type": "string" }
      }
    }
  }
}
